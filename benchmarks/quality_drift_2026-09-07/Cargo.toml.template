[package]
name="quality-drift-probe"
version="0.0.0"
edition="2024"
[workspace]
[dependencies]
image={version="=0.25.10",default-features=false,features=["png"]}
ravif={package="zenravif",path="@OWNER@",default-features=false,features=["threading","imazen","stop"]}
zenavif={path="@ZENAVIF@"}
imgref="1.12.0"
rgb="0.8"
fast-ssim2={version="=0.8.2",features=["imgref","rayon"]}
[patch.crates-io]
zenavif-serialize={path="@ZENAVIF@/zenavif-serialize"}
zenanalyze-api={git="https://github.com/imazen/zenanalyze"}
[profile.release]
debug=1

[patch."https://github.com/imazen/zenavif"]
zenavif-serialize={path="@ZENAVIF@/zenavif-serialize"}

+    let dump_planes = |frame: &Frame<P>, suffix: &str| {
+        if let Some(dir) = std::env::var_os("PROBE_RECON") {
+            let dir = std::path::PathBuf::from(dir);
+            std::fs::create_dir_all(&dir).unwrap();
+            let mut data = Vec::new();
+            let count = if p.chroma_sampling == ChromaSampling::Cs400 { 1 } else { 3 };
+            for plane in &frame.planes[..count] {
+                let width = p.width.div_ceil(1 << plane.cfg.xdec);
+                let height = p.height.div_ceil(1 << plane.cfg.ydec);
+                for row in plane.slice(Default::default()).rows_iter().take(height) {
+                    for &value in &row[..width] {
+                        let value = u16::cast_from(value);
+                        if p.bit_depth == 8 { data.push(value as u8); } else { data.extend_from_slice(&value.to_le_bytes()); }
+                    }
+                }
+            }
+            std::fs::write(dir.join(suffix), data).unwrap();
+        }
+    };

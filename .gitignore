/debug_simd

# Test vectors (large binary files - download with scripts/download-avif-test-vectors.sh)
tests/vectors/*
*.avif
*.ivf
*.obu
# But keep the download script
!scripts/download-avif-test-vectors.sh
# Committed CI fixtures (~28 KB total): the tiny generated mono vectors plus
# the one libavif vector the fail-loud tests read. Everything else under
# tests/vectors/ stays download-only.
!tests/vectors/zenavif/
!tests/vectors/zenavif/*.avif
!tests/vectors/libavif/
tests/vectors/libavif/*
!tests/vectors/libavif/kodim03_yuv420_8bpc.avif
tests/zenavif-references/
tests/linku-references/

# === Standard exclusions (do not depend on user ~/.gitignore) ===

# Rust build artifacts
target/

# Fuzz build artifacts and crashes
fuzz/target/
fuzz/artifacts/
fuzz/corpus/
fuzz/coverage/
fuzz-*.log
*.profraw
*.profdata

# Profiling
perf.data
perf.data.old
flamegraph.svg
heaptrack.*.zst
cachegrind.out.*
callgrind.out.*
massif.out.*

# C/C++ build artifacts
*.o
*.obj
*.a
*.lib
*.so
*.dylib
*.dll
*.rlib

# Compiled binaries with no extension
rust_out

# Node
node_modules/

# OS
.DS_Store
Thumbs.db

# Editors
*.swp
*.swo
*~
.idea/
.vscode/
*.iml
!fuzz/Cargo.lock

# Tooling noise
.superwork/
.claude/
copter-report/
.zenbench/
.external-cache/
Cargo.toml.original.txt
*.rs.local
.workongoing

# Multi-agent coordination marker (per global CLAUDE.md)
.workongoing

# Research-notes mirrors from zenpapers (gitignored canonical home)
*_LEARNINGS.md
*_LEARNINGS_FOR_*.md

# In-progress predictor sweep TSVs — final results committed after run completes
# (with `jj --config snapshot.max-new-file-size=...`).
benchmarks/rav1e_phase1a_*.tsv
training/__pycache__/
benchmarks/rav1e_phase1a_*.tsv.clean

# Training intermediates — large + reproducible from TSVs
benchmarks/rav1e_picker_*.json
benchmarks/rav1e_picker_*.manifest.json
benchmarks/rav1e_picker_*.log
benchmarks/rav1e_encode_ms_lut*.json
benchmarks/rav1e_quality_lut*.json
benchmarks/rav1e_picker_*.bin
cron-logs/
# Phase 2 OAT TSV is small (~560 KB) + load-bearing provenance for
# the cull → keep it. Just ignore the in-flight large rotating
# Phase 3 TSVs which can balloon.
benchmarks/rav1e_phase3_*.tsv
benchmarks/rav1e_phase3_*.tsv.clean

# Benchmark data files larger than 1 MB are archived to /mnt/v
# (durable storage). Keep small summary .md / .log files in repo;
# mass tabular data (.parquet, large .tsv, large .json from training
# dumps) goes to /mnt/v or R2.
benchmarks/*.parquet
benchmarks/zenavif_pareto_v05c_*.tsv
benchmarks/zenavif_pareto_*_extended.tsv
benchmarks/zenavif_pareto_v04_2026-05-04*.tsv
benchmarks/zenavif_features_v05c_*.tsv
benchmarks/rav1e_phase1a_2026-04-30.parquet
benchmarks/rav1e_phase1a_hybrid_*.json
benchmarks/zenavif_hybrid_v2_*.json
.cargo/config.toml

# rd_gap harness generated outputs
scripts/rd_gap/sample_images.tsv
scripts/rd_gap/rd_gap_results.tsv
scripts/rd_gap/*_summary.csv
scripts/rd_gap/palette_ablation_results.tsv
scripts/rd_gap/tool_ablation_results.tsv
*.profraw
